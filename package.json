{
  "name": "opfs-strands-agent",
  "version": "1.0.0",
  "description": "Strands Agent boilerplate with OPFS file operations using TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@strands-agents/sdk": "^0.5.0",
    "opfs-worker": "^1.3.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@angular/common": "^21.2.1",
    "@angular/core": "^21.2.1",
    "@angular/forms": "^21.2.1",
    "@angular/platform-browser": "^21.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "fast-check": "^4.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "typescript": "^5.7.2",
    "vite": "^6.2.1",
    "vitest": "^4.0.18",
    "zone.js": "^0.16.1"
  }
}
